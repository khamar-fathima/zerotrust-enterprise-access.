{
  "name": "zerotrust-enterprise-access",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,magenta \"node --watch server/index.js\" \"vite --config vite.config.js --host 0.0.0.0 --port 5000\"",
    "build": "vite --config vite.config.js build && npm run check:bundle",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/tests/*.test.js client/tests/*.test.js",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.59.0",
    "mongoose": "^9.11.2",
    "otplib": "^13.5.0",
    "postcss": "^8.5.31",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  }
}
